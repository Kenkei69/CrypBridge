{
  "name": "x402-red-blue",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "postinstall": "prisma generate",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "db:setup": "prisma db push && prisma db execute --schema prisma/schema.prisma --file prisma/testnet-invariants.sql && prisma db execute --schema prisma/schema.prisma --file prisma/lab-invariants.sql",
    "test:ui": "playwright test tests/e2e/lab.spec.ts",
    "test:ui:simulation": "playwright test tests/e2e/simulation.spec.ts",
    "wallet:provision": "tsx scripts/provision-test-wallets.ts",
    "test:ui:testnet": "playwright test tests/e2e/testnet.spec.ts",
    "sim:verify": "tsx scripts/verify-simulation.ts",
    "sim:verify:restart": "tsx scripts/verify-simulation-restart.ts",
    "test:simulation": "vitest run tests/lab.test.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "@x402/core": "^2.29.0",
    "@x402/evm": "^2.29.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "lucide-react": "^1.66.0",
    "pdfkit": "^0.20.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "viem": "^2.57.13",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.5",
    "fast-check": "^4.3.0",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
