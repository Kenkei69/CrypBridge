# API only. Generate two DIFFERENT random secrets: openssl rand -hex 32
APP_ENV=production
NODE_ENV=production
HOST=0.0.0.0
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SIMULATION_MODE=true
ALLOW_HOSTED_SIMULATION=true
SIMULATION_SIGNER_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
GUARDIAN_SIGNER_PERMIT_SECRET=REPLACE_WITH_ANOTHER_RANDOM_64_HEX_SECRET
ALLOWED_ORIGINS=https://YOUR_FRONTEND.vercel.app
LOG_LEVEL=info
RATE_LIMIT_MAX=100

# Frontend build only; the anon/publishable key is public, NEVER use service_role.
NEXT_PUBLIC_API_URL=https://YOUR_API_HOST
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
