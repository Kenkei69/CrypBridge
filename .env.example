# Active milestone: all financial activity is simulated. Real APIs/signing/indexing are disabled.
CRYPBRIDGE_MODE=simulation
# Explicit operator deployment can select testnet; never switch via browser input.
DATABASE_URL=postgresql://x402:change-me@localhost:5432/x402
# Shared demo operator with explicit Blue/Red workspace sessions. No real funds.
DEMO_MODE=true
PORT=3001
APP_ORIGIN=http://localhost:5000
# Optional comma-separated exact deployment origins. No wildcards.
APP_ORIGINS=
# Set automatically from Replit's exact domain environment variables in preview.
# Non-demo deployments require an operator bearer token and explicit mock enablement.
ADMIN_TOKEN=
MOCK_SIMULATION_ENABLED=false
# Optional. Default uses the API's own loopback HTTP origin.
# MOCK_MERCHANT_ORIGIN=http://127.0.0.1:3001
# Force Secure session cookies when TLS is terminated at a trusted proxy.
SESSION_SECURE=false
# Explicit HTTPS origins for external guard tests. Private destinations remain blocked.
GUARD_ALLOWED_ORIGINS=
# Legacy outbound bearer token or optional per-guard references to GUARD_SECRET_* variables.
GUARD_API_TOKEN=
# GUARD_SECRET_TEAM_NAME=
# Optional custom LLM intent adapter. No provider/key is required for the deterministic assistant.
# Must return {intent, resourceId?, budget?}; it has no signing or authorization capability.
DIALOGUE_ADAPTER_URL=
DIALOGUE_ALLOWED_ORIGINS=
DIALOGUE_API_TOKEN=

# Optional retained testnet configuration, used ONLY with CRYPBRIDGE_MODE=testnet.
# Never put keys in frontend VITE_* variables.
PAYMENT_MODE=testnet
CHAIN_ID=84532
NETWORK=eip155:84532
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_SECONDARY_RPC_URL=
USDC_CONTRACT=0x036CbD53842c5426634e7929541eC2318f3dCF7e
BLOCK_EXPLORER=https://sepolia.basescan.org
BUYER_ADDRESS=
# Provision a dedicated funded test wallet and inject this via the server secret manager.
BUYER_PRIVATE_KEY=
MERCHANT_ADDRESS=
ATTACKER_ADDRESS=
MERCHANT_PUBLIC_ORIGIN=http://127.0.0.1:3001
X402_FACILITATOR_URL=https://x402.primer.systems
PAYMENT_CONFIRMATIONS=3
INDEXER_CONFIRMATIONS=3
# Set explicitly for historical backfill; otherwise starts at the current confirmed head.
INDEXER_START_BLOCK=
# Funded signing and sensitive investigations require DEMO_MODE=false and ADMIN_TOKEN.
# Browser deployments must use an authenticated gateway that supplies operator API auth.
# Optional server-only path to a protected dotenv credential file:
# TESTNET_WALLET_ENV_FILE=.secrets/testnet.env
