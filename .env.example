# x402 Guardian Environment Configuration Template
# Copy to .env and configure for your local environment

# Server Runtime
PORT=4000
HOST=0.0.0.0
APP_ENV=development
NODE_ENV=development
LOG_LEVEL=info

# Database Configuration (PostgreSQL 15+)
# Example: postgresql://postgres:postgres@localhost:5432/x402_guardian
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/x402_guardian

# Supabase Auth / JWT Configuration
# Minimum 16 characters for cryptographic HMAC-SHA256 signing
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-at-least-16-chars
SUPABASE_URL=http://localhost:54321

# Guardian Security & Simulation Flags
# Keep SIMULATION_MODE=true in Phase 1 to prevent real signing / settlement attempts
SIMULATION_MODE=true

# Security: Allowed Origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.replit.dev

# Rate Limiting (max requests per minute)
RATE_LIMIT_MAX=100
